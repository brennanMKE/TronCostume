#usda 1.0
(
    defaultPrim = "TronFrameReview"
    metersPerUnit = 0.001
    upAxis = "Z"
)

def Xform "TronFrameReview" {
  def Camera "Camera" {
    double3 xformOp:translate = (0, 0, 520)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    float focalLength = 50
    float horizontalAperture = 32
    float verticalAperture = 32
    float2 clippingRange = (1, 2000)
  }
  def DistantLight "KeyLight" {
    float intensity = 1200
    float angle = 0.6
    color3f color = (1.0, 0.94, 0.86)
    float3 xformOp:rotateXYZ = (25, -30, 20)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
  }
  def Material "mat_wood" {
    token outputs:surface.connect = </TronFrameReview/mat_wood/PBR.outputs:surface>
    def Shader "PBR" {
      uniform token info:id = "UsdPreviewSurface"
      color3f inputs:diffuseColor = (0.72, 0.5, 0.25)
      float inputs:roughness = 0.55
      float inputs:metallic = 0.0
      token outputs:surface
    }
  }
  def Material "mat_black" {
    token outputs:surface.connect = </TronFrameReview/mat_black/PBR.outputs:surface>
    def Shader "PBR" {
      uniform token info:id = "UsdPreviewSurface"
      color3f inputs:diffuseColor = (0.025, 0.03, 0.04)
      float inputs:roughness = 0.28
      float inputs:metallic = 0.0
      token outputs:surface
    }
  }
  def Material "mat_pcb_blue" {
    token outputs:surface.connect = </TronFrameReview/mat_pcb_blue/PBR.outputs:surface>
    def Shader "PBR" {
      uniform token info:id = "UsdPreviewSurface"
      color3f inputs:diffuseColor = (0.03, 0.24, 0.55)
      float inputs:roughness = 0.35
      float inputs:metallic = 0.05
      token outputs:surface
    }
  }
  def Material "mat_pcb_green" {
    token outputs:surface.connect = </TronFrameReview/mat_pcb_green/PBR.outputs:surface>
    def Shader "PBR" {
      uniform token info:id = "UsdPreviewSurface"
      color3f inputs:diffuseColor = (0.03, 0.38, 0.2)
      float inputs:roughness = 0.38
      float inputs:metallic = 0.02
      token outputs:surface
    }
  }
  def Material "mat_battery" {
    token outputs:surface.connect = </TronFrameReview/mat_battery/PBR.outputs:surface>
    def Shader "PBR" {
      uniform token info:id = "UsdPreviewSurface"
      color3f inputs:diffuseColor = (0.74, 0.16, 0.35)
      float inputs:roughness = 0.32
      float inputs:metallic = 0.22
      token outputs:surface
    }
  }
  def Material "mat_metal" {
    token outputs:surface.connect = </TronFrameReview/mat_metal/PBR.outputs:surface>
    def Shader "PBR" {
      uniform token info:id = "UsdPreviewSurface"
      color3f inputs:diffuseColor = (0.7, 0.54, 0.12)
      float inputs:roughness = 0.24
      float inputs:metallic = 0.7
      token outputs:surface
    }
  }
  def Material "mat_usb" {
    token outputs:surface.connect = </TronFrameReview/mat_usb/PBR.outputs:surface>
    def Shader "PBR" {
      uniform token info:id = "UsdPreviewSurface"
      color3f inputs:diffuseColor = (0.38, 0.42, 0.46)
      float inputs:roughness = 0.22
      float inputs:metallic = 0.85
      token outputs:surface
    }
  }
  def Material "mat_button" {
    token outputs:surface.connect = </TronFrameReview/mat_button/PBR.outputs:surface>
    def Shader "PBR" {
      uniform token info:id = "UsdPreviewSurface"
      color3f inputs:diffuseColor = (0.8, 0.08, 0.05)
      float inputs:roughness = 0.3
      float inputs:metallic = 0.0
      token outputs:surface
    }
  }
  def Mesh "wood" (
